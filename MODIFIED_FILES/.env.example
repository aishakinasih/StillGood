# Local app configuration
NODE_ENV=development
DATABASE_URL=postgresql://stillgood:stillgood_dev_password@localhost:5432/stillgood?schema=public
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
APP_TIME_ZONE=Asia/Jakarta

# Web / API
WEB_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
PORT=4000
ENABLE_ORDER_SCHEDULER=true

# Payment: QRIS only; mock simulates the QRIS flow, midtrans enables Midtrans QRIS Sandbox/Production
PAYMENT_MODE=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Google Maps Geocoding API (optional; manual latitude/longitude also supported)
GOOGLE_MAPS_API_KEY=

# Optional admin account created by npm run db:seed
SEED_ADMIN_NAME=Still Good Admin
SEED_ADMIN_EMAIL=admin@stillgood.local
SEED_ADMIN_PASSWORD=
