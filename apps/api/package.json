{
  "name": "@still-good/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "start": "tsx src/server.js",
    "check": "node --check src/server.js && node --check src/routes/api.js && node --check src/middleware/auth.js && node --check src/services/maps.service.js && node --check src/services/payment.service.js && node --check src/services/notification.service.js && node --check src/services/scheduler.service.js && node --check src/lib/errors.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.js",
    "db:create-seller": "tsx prisma/create-seller.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
